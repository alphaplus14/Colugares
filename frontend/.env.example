# MongoDB
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/
MONGODB_URI=
MONGODB_DB_NAME=colugares

# Auth.js (NextAuth v5)
# Generar con: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
# 1. Crear proyecto → APIs & Services → Credentials → OAuth client ID
# 2. Tipo: Web application
# 3. Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Copia los valores reales SOLO en .env.local (nunca en este archivo)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mapa itinerario (Fase 4) — MapLibre + Carto, sin API key
# NEXT_PUBLIC_MAP_STYLE_URL=

# Backend proxy (CMS Fase 2)
BACKEND_URL=http://localhost:4000
INTERNAL_API_KEY=

# Google Gemini (AI Planner Fase 3)
# IMPORTANTE: debe ser la MISMA key que backend/.env (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_LLM_MODEL=gemini-2.5-flash

# Vector Search — false en local, true en Atlas M10+ (ver DEPLOY.md)
USE_ATLAS_VECTOR_SEARCH=false
